{
  "name": "zcode-ru",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Русская локализация ZCode Desktop: патч установленного app.asar под свою версию (плагины не ломаются)",
  "scripts": {
    "extract": "node scripts/extract.mjs /Applications/ZCode.app/Contents/Resources/app.asar",
    "check": "node scripts/check-dict.mjs",
    "build": "node scripts/patch-asar.mjs /Applications/ZCode.app/Contents/Resources/app.asar build/app-ru.asar",
    "validate": "node scripts/validate.mjs /Applications/ZCode.app/Contents/Resources/app.asar build/app-ru.asar"
  },
  "dependencies": {
    "@electron/asar": "^4.3.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}